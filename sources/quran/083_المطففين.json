[
  {
    "id": "quran_83_1",
    "text": " وَيْلٌ لِّلْمُطَفِّفِينَ",
    "book": "المطففين",
    "number": "83:1",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_2",
    "text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
    "book": "المطففين",
    "number": "83:2",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_3",
    "text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
    "book": "المطففين",
    "number": "83:3",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_4",
    "text": "أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
    "book": "المطففين",
    "number": "83:4",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_5",
    "text": "لِيَوْمٍ عَظِيمٍ",
    "book": "المطففين",
    "number": "83:5",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_6",
    "text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ",
    "book": "المطففين",
    "number": "83:6",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_7",
    "text": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ",
    "book": "المطففين",
    "number": "83:7",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_8",
    "text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ",
    "book": "المطففين",
    "number": "83:8",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_9",
    "text": "كِتَـٰبٌ مَّرْقُومٌ",
    "book": "المطففين",
    "number": "83:9",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_10",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المطففين",
    "number": "83:10",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_11",
    "text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
    "book": "المطففين",
    "number": "83:11",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_12",
    "text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
    "book": "المطففين",
    "number": "83:12",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_13",
    "text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ",
    "book": "المطففين",
    "number": "83:13",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_14",
    "text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
    "book": "المطففين",
    "number": "83:14",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_15",
    "text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ",
    "book": "المطففين",
    "number": "83:15",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_16",
    "text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
    "book": "المطففين",
    "number": "83:16",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_17",
    "text": "ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
    "book": "المطففين",
    "number": "83:17",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_18",
    "text": "كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
    "book": "المطففين",
    "number": "83:18",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_19",
    "text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
    "book": "المطففين",
    "number": "83:19",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_20",
    "text": "كِتَـٰبٌ مَّرْقُومٌ",
    "book": "المطففين",
    "number": "83:20",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_21",
    "text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
    "book": "المطففين",
    "number": "83:21",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_22",
    "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
    "book": "المطففين",
    "number": "83:22",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_23",
    "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
    "book": "المطففين",
    "number": "83:23",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_24",
    "text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
    "book": "المطففين",
    "number": "83:24",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_25",
    "text": "يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ",
    "book": "المطففين",
    "number": "83:25",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_26",
    "text": "خِتَـٰمُهُۥ مِسْكٌ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَـٰفِسُونَ",
    "book": "المطففين",
    "number": "83:26",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_27",
    "text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
    "book": "المطففين",
    "number": "83:27",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_28",
    "text": "عَيْنًا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
    "book": "المطففين",
    "number": "83:28",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_29",
    "text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
    "book": "المطففين",
    "number": "83:29",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_30",
    "text": "وَإِذَا مَرُّوا۟ بِهِمْ يَتَغَامَزُونَ",
    "book": "المطففين",
    "number": "83:30",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_31",
    "text": "وَإِذَا ٱنقَلَبُوٓا۟ إِلَىٰٓ أَهْلِهِمُ ٱنقَلَبُوا۟ فَكِهِينَ",
    "book": "المطففين",
    "number": "83:31",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_32",
    "text": "وَإِذَا رَأَوْهُمْ قَالُوٓا۟ إِنَّ هَـٰٓؤُلَآءِ لَضَآلُّونَ",
    "book": "المطففين",
    "number": "83:32",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_33",
    "text": "وَمَآ أُرْسِلُوا۟ عَلَيْهِمْ حَـٰفِظِينَ",
    "book": "المطففين",
    "number": "83:33",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_34",
    "text": "فَٱلْيَوْمَ ٱلَّذِينَ ءَامَنُوا۟ مِنَ ٱلْكُفَّارِ يَضْحَكُونَ",
    "book": "المطففين",
    "number": "83:34",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_35",
    "text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
    "book": "المطففين",
    "number": "83:35",
    "chapter": "المطففين"
  },
  {
    "id": "quran_83_36",
    "text": "هَلْ ثُوِّبَ ٱلْكُفَّارُ مَا كَانُوا۟ يَفْعَلُونَ",
    "book": "المطففين",
    "number": "83:36",
    "chapter": "المطففين"
  }
]