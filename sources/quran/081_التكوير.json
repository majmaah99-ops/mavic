[
  {
    "id": "quran_81_1",
    "text": " إِذَا ٱلشَّمْسُ كُوِّرَتْ",
    "book": "التكوير",
    "number": "81:1",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_2",
    "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
    "book": "التكوير",
    "number": "81:2",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_3",
    "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
    "book": "التكوير",
    "number": "81:3",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_4",
    "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
    "book": "التكوير",
    "number": "81:4",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_5",
    "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
    "book": "التكوير",
    "number": "81:5",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_6",
    "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
    "book": "التكوير",
    "number": "81:6",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_7",
    "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
    "book": "التكوير",
    "number": "81:7",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_8",
    "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
    "book": "التكوير",
    "number": "81:8",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_9",
    "text": "بِأَىِّ ذَنۢبٍ قُتِلَتْ",
    "book": "التكوير",
    "number": "81:9",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_10",
    "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
    "book": "التكوير",
    "number": "81:10",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_11",
    "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
    "book": "التكوير",
    "number": "81:11",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_12",
    "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
    "book": "التكوير",
    "number": "81:12",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_13",
    "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
    "book": "التكوير",
    "number": "81:13",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_14",
    "text": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ",
    "book": "التكوير",
    "number": "81:14",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_15",
    "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
    "book": "التكوير",
    "number": "81:15",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_16",
    "text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
    "book": "التكوير",
    "number": "81:16",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_17",
    "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
    "book": "التكوير",
    "number": "81:17",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_18",
    "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
    "book": "التكوير",
    "number": "81:18",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_19",
    "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
    "book": "التكوير",
    "number": "81:19",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_20",
    "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ",
    "book": "التكوير",
    "number": "81:20",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_21",
    "text": "مُّطَاعٍ ثَمَّ أَمِينٍ",
    "book": "التكوير",
    "number": "81:21",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_22",
    "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍ",
    "book": "التكوير",
    "number": "81:22",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_23",
    "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
    "book": "التكوير",
    "number": "81:23",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_24",
    "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ",
    "book": "التكوير",
    "number": "81:24",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_25",
    "text": "وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ",
    "book": "التكوير",
    "number": "81:25",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_26",
    "text": "فَأَيْنَ تَذْهَبُونَ",
    "book": "التكوير",
    "number": "81:26",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_27",
    "text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَـٰلَمِينَ",
    "book": "التكوير",
    "number": "81:27",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_28",
    "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
    "book": "التكوير",
    "number": "81:28",
    "chapter": "التكوير"
  },
  {
    "id": "quran_81_29",
    "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَـٰلَمِينَ",
    "book": "التكوير",
    "number": "81:29",
    "chapter": "التكوير"
  }
]