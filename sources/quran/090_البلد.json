[
  {
    "id": "quran_90_1",
    "text": " لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
    "book": "البلد",
    "number": "90:1",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_2",
    "text": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
    "book": "البلد",
    "number": "90:2",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_3",
    "text": "وَوَالِدٍ وَمَا وَلَدَ",
    "book": "البلد",
    "number": "90:3",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_4",
    "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
    "book": "البلد",
    "number": "90:4",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_5",
    "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
    "book": "البلد",
    "number": "90:5",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_6",
    "text": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
    "book": "البلد",
    "number": "90:6",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_7",
    "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
    "book": "البلد",
    "number": "90:7",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_8",
    "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
    "book": "البلد",
    "number": "90:8",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_9",
    "text": "وَلِسَانًا وَشَفَتَيْنِ",
    "book": "البلد",
    "number": "90:9",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_10",
    "text": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
    "book": "البلد",
    "number": "90:10",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_11",
    "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
    "book": "البلد",
    "number": "90:11",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_12",
    "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
    "book": "البلد",
    "number": "90:12",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_13",
    "text": "فَكُّ رَقَبَةٍ",
    "book": "البلد",
    "number": "90:13",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_14",
    "text": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
    "book": "البلد",
    "number": "90:14",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_15",
    "text": "يَتِيمًا ذَا مَقْرَبَةٍ",
    "book": "البلد",
    "number": "90:15",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_16",
    "text": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
    "book": "البلد",
    "number": "90:16",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_17",
    "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
    "book": "البلد",
    "number": "90:17",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_18",
    "text": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
    "book": "البلد",
    "number": "90:18",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_19",
    "text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
    "book": "البلد",
    "number": "90:19",
    "chapter": "البلد"
  },
  {
    "id": "quran_90_20",
    "text": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
    "book": "البلد",
    "number": "90:20",
    "chapter": "البلد"
  }
]