[
  {
    "id": "quran_80_1",
    "text": " عَبَسَ وَتَوَلَّىٰٓ",
    "book": "عبس",
    "number": "80:1",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_2",
    "text": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
    "book": "عبس",
    "number": "80:2",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_3",
    "text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
    "book": "عبس",
    "number": "80:3",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_4",
    "text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
    "book": "عبس",
    "number": "80:4",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_5",
    "text": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
    "book": "عبس",
    "number": "80:5",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_6",
    "text": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
    "book": "عبس",
    "number": "80:6",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_7",
    "text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
    "book": "عبس",
    "number": "80:7",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_8",
    "text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
    "book": "عبس",
    "number": "80:8",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_9",
    "text": "وَهُوَ يَخْشَىٰ",
    "book": "عبس",
    "number": "80:9",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_10",
    "text": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
    "book": "عبس",
    "number": "80:10",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_11",
    "text": "كَلَّآ إِنَّهَا تَذْكِرَةٌ",
    "book": "عبس",
    "number": "80:11",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_12",
    "text": "فَمَن شَآءَ ذَكَرَهُۥ",
    "book": "عبس",
    "number": "80:12",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_13",
    "text": "فِى صُحُفٍ مُّكَرَّمَةٍ",
    "book": "عبس",
    "number": "80:13",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_14",
    "text": "مَّرْفُوعَةٍ مُّطَهَّرَةٍۭ",
    "book": "عبس",
    "number": "80:14",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_15",
    "text": "بِأَيْدِى سَفَرَةٍ",
    "book": "عبس",
    "number": "80:15",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_16",
    "text": "كِرَامٍۭ بَرَرَةٍ",
    "book": "عبس",
    "number": "80:16",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_17",
    "text": "قُتِلَ ٱلْإِنسَـٰنُ مَآ أَكْفَرَهُۥ",
    "book": "عبس",
    "number": "80:17",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_18",
    "text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
    "book": "عبس",
    "number": "80:18",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_19",
    "text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
    "book": "عبس",
    "number": "80:19",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_20",
    "text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
    "book": "عبس",
    "number": "80:20",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_21",
    "text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
    "book": "عبس",
    "number": "80:21",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_22",
    "text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
    "book": "عبس",
    "number": "80:22",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_23",
    "text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
    "book": "عبس",
    "number": "80:23",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_24",
    "text": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ إِلَىٰ طَعَامِهِۦٓ",
    "book": "عبس",
    "number": "80:24",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_25",
    "text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّا",
    "book": "عبس",
    "number": "80:25",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_26",
    "text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّا",
    "book": "عبس",
    "number": "80:26",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_27",
    "text": "فَأَنۢبَتْنَا فِيهَا حَبًّا",
    "book": "عبس",
    "number": "80:27",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_28",
    "text": "وَعِنَبًا وَقَضْبًا",
    "book": "عبس",
    "number": "80:28",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_29",
    "text": "وَزَيْتُونًا وَنَخْلًا",
    "book": "عبس",
    "number": "80:29",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_30",
    "text": "وَحَدَآئِقَ غُلْبًا",
    "book": "عبس",
    "number": "80:30",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_31",
    "text": "وَفَـٰكِهَةً وَأَبًّا",
    "book": "عبس",
    "number": "80:31",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_32",
    "text": "مَّتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
    "book": "عبس",
    "number": "80:32",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_33",
    "text": "فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",
    "book": "عبس",
    "number": "80:33",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_34",
    "text": "يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",
    "book": "عبس",
    "number": "80:34",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_35",
    "text": "وَأُمِّهِۦ وَأَبِيهِ",
    "book": "عبس",
    "number": "80:35",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_36",
    "text": "وَصَـٰحِبَتِهِۦ وَبَنِيهِ",
    "book": "عبس",
    "number": "80:36",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_37",
    "text": "لِكُلِّ ٱمْرِئٍ مِّنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ",
    "book": "عبس",
    "number": "80:37",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_38",
    "text": "وُجُوهٌ يَوْمَئِذٍ مُّسْفِرَةٌ",
    "book": "عبس",
    "number": "80:38",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_39",
    "text": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ",
    "book": "عبس",
    "number": "80:39",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_40",
    "text": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ",
    "book": "عبس",
    "number": "80:40",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_41",
    "text": "تَرْهَقُهَا قَتَرَةٌ",
    "book": "عبس",
    "number": "80:41",
    "chapter": "عبس"
  },
  {
    "id": "quran_80_42",
    "text": "أُو۟لَـٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",
    "book": "عبس",
    "number": "80:42",
    "chapter": "عبس"
  }
]