[
  {
    "id": "quran_89_1",
    "text": " وَٱلْفَجْرِ",
    "book": "الفجر",
    "number": "89:1",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_2",
    "text": "وَلَيَالٍ عَشْرٍ",
    "book": "الفجر",
    "number": "89:2",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_3",
    "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
    "book": "الفجر",
    "number": "89:3",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_4",
    "text": "وَٱلَّيْلِ إِذَا يَسْرِ",
    "book": "الفجر",
    "number": "89:4",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_5",
    "text": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ",
    "book": "الفجر",
    "number": "89:5",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_6",
    "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
    "book": "الفجر",
    "number": "89:6",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_7",
    "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
    "book": "الفجر",
    "number": "89:7",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_8",
    "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ",
    "book": "الفجر",
    "number": "89:8",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_9",
    "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
    "book": "الفجر",
    "number": "89:9",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_10",
    "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
    "book": "الفجر",
    "number": "89:10",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_11",
    "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ",
    "book": "الفجر",
    "number": "89:11",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_12",
    "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
    "book": "الفجر",
    "number": "89:12",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_13",
    "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
    "book": "الفجر",
    "number": "89:13",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_14",
    "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
    "book": "الفجر",
    "number": "89:14",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_15",
    "text": "فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
    "book": "الفجر",
    "number": "89:15",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_16",
    "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ",
    "book": "الفجر",
    "number": "89:16",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_17",
    "text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
    "book": "الفجر",
    "number": "89:17",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_18",
    "text": "وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
    "book": "الفجر",
    "number": "89:18",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_19",
    "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا",
    "book": "الفجر",
    "number": "89:19",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_20",
    "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا",
    "book": "الفجر",
    "number": "89:20",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_21",
    "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا",
    "book": "الفجر",
    "number": "89:21",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_22",
    "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا",
    "book": "الفجر",
    "number": "89:22",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_23",
    "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
    "book": "الفجر",
    "number": "89:23",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_24",
    "text": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
    "book": "الفجر",
    "number": "89:24",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_25",
    "text": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
    "book": "الفجر",
    "number": "89:25",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_26",
    "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
    "book": "الفجر",
    "number": "89:26",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_27",
    "text": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
    "book": "الفجر",
    "number": "89:27",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_28",
    "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
    "book": "الفجر",
    "number": "89:28",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_29",
    "text": "فَٱدْخُلِى فِى عِبَـٰدِى",
    "book": "الفجر",
    "number": "89:29",
    "chapter": "الفجر"
  },
  {
    "id": "quran_89_30",
    "text": "وَٱدْخُلِى جَنَّتِى",
    "book": "الفجر",
    "number": "89:30",
    "chapter": "الفجر"
  }
]