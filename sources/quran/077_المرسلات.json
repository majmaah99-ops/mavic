[
  {
    "id": "quran_77_1",
    "text": " وَٱلْمُرْسَلَـٰتِ عُرْفًا",
    "book": "المرسلات",
    "number": "77:1",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_2",
    "text": "فَٱلْعَـٰصِفَـٰتِ عَصْفًا",
    "book": "المرسلات",
    "number": "77:2",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_3",
    "text": "وَٱلنَّـٰشِرَٰتِ نَشْرًا",
    "book": "المرسلات",
    "number": "77:3",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_4",
    "text": "فَٱلْفَـٰرِقَـٰتِ فَرْقًا",
    "book": "المرسلات",
    "number": "77:4",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_5",
    "text": "فَٱلْمُلْقِيَـٰتِ ذِكْرًا",
    "book": "المرسلات",
    "number": "77:5",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_6",
    "text": "عُذْرًا أَوْ نُذْرًا",
    "book": "المرسلات",
    "number": "77:6",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_7",
    "text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌ",
    "book": "المرسلات",
    "number": "77:7",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_8",
    "text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
    "book": "المرسلات",
    "number": "77:8",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_9",
    "text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
    "book": "المرسلات",
    "number": "77:9",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_10",
    "text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
    "book": "المرسلات",
    "number": "77:10",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_11",
    "text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
    "book": "المرسلات",
    "number": "77:11",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_12",
    "text": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
    "book": "المرسلات",
    "number": "77:12",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_13",
    "text": "لِيَوْمِ ٱلْفَصْلِ",
    "book": "المرسلات",
    "number": "77:13",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_14",
    "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
    "book": "المرسلات",
    "number": "77:14",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_15",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:15",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_16",
    "text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
    "book": "المرسلات",
    "number": "77:16",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_17",
    "text": "ثُمَّ نُتْبِعُهُمُ ٱلْـَٔاخِرِينَ",
    "book": "المرسلات",
    "number": "77:17",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_18",
    "text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
    "book": "المرسلات",
    "number": "77:18",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_19",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:19",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_20",
    "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
    "book": "المرسلات",
    "number": "77:20",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_21",
    "text": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
    "book": "المرسلات",
    "number": "77:21",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_22",
    "text": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
    "book": "المرسلات",
    "number": "77:22",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_23",
    "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
    "book": "المرسلات",
    "number": "77:23",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_24",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:24",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_25",
    "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
    "book": "المرسلات",
    "number": "77:25",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_26",
    "text": "أَحْيَآءً وَأَمْوَٰتًا",
    "book": "المرسلات",
    "number": "77:26",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_27",
    "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
    "book": "المرسلات",
    "number": "77:27",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_28",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:28",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_29",
    "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
    "book": "المرسلات",
    "number": "77:29",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_30",
    "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
    "book": "المرسلات",
    "number": "77:30",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_31",
    "text": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
    "book": "المرسلات",
    "number": "77:31",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_32",
    "text": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
    "book": "المرسلات",
    "number": "77:32",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_33",
    "text": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
    "book": "المرسلات",
    "number": "77:33",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_34",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:34",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_35",
    "text": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
    "book": "المرسلات",
    "number": "77:35",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_36",
    "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
    "book": "المرسلات",
    "number": "77:36",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_37",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:37",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_38",
    "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
    "book": "المرسلات",
    "number": "77:38",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_39",
    "text": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
    "book": "المرسلات",
    "number": "77:39",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_40",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:40",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_41",
    "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
    "book": "المرسلات",
    "number": "77:41",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_42",
    "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
    "book": "المرسلات",
    "number": "77:42",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_43",
    "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
    "book": "المرسلات",
    "number": "77:43",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_44",
    "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
    "book": "المرسلات",
    "number": "77:44",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_45",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:45",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_46",
    "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
    "book": "المرسلات",
    "number": "77:46",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_47",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:47",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_48",
    "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
    "book": "المرسلات",
    "number": "77:48",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_49",
    "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
    "book": "المرسلات",
    "number": "77:49",
    "chapter": "المرسلات"
  },
  {
    "id": "quran_77_50",
    "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
    "book": "المرسلات",
    "number": "77:50",
    "chapter": "المرسلات"
  }
]