[
  {
    "id": "quran_92_1",
    "text": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
    "book": "الليل",
    "number": "92:1",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_2",
    "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
    "book": "الليل",
    "number": "92:2",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_3",
    "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
    "book": "الليل",
    "number": "92:3",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_4",
    "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
    "book": "الليل",
    "number": "92:4",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_5",
    "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
    "book": "الليل",
    "number": "92:5",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_6",
    "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
    "book": "الليل",
    "number": "92:6",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_7",
    "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
    "book": "الليل",
    "number": "92:7",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_8",
    "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
    "book": "الليل",
    "number": "92:8",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_9",
    "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
    "book": "الليل",
    "number": "92:9",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_10",
    "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
    "book": "الليل",
    "number": "92:10",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_11",
    "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
    "book": "الليل",
    "number": "92:11",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_12",
    "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
    "book": "الليل",
    "number": "92:12",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_13",
    "text": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
    "book": "الليل",
    "number": "92:13",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_14",
    "text": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
    "book": "الليل",
    "number": "92:14",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_15",
    "text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
    "book": "الليل",
    "number": "92:15",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_16",
    "text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
    "book": "الليل",
    "number": "92:16",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_17",
    "text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
    "book": "الليل",
    "number": "92:17",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_18",
    "text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
    "book": "الليل",
    "number": "92:18",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_19",
    "text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ",
    "book": "الليل",
    "number": "92:19",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_20",
    "text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
    "book": "الليل",
    "number": "92:20",
    "chapter": "الليل"
  },
  {
    "id": "quran_92_21",
    "text": "وَلَسَوْفَ يَرْضَىٰ",
    "book": "الليل",
    "number": "92:21",
    "chapter": "الليل"
  }
]