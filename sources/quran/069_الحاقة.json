[
  {
    "id": "quran_69_1",
    "text": " ٱلْحَآقَّةُ",
    "book": "الحاقة",
    "number": "69:1",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_2",
    "text": "مَا ٱلْحَآقَّةُ",
    "book": "الحاقة",
    "number": "69:2",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_3",
    "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
    "book": "الحاقة",
    "number": "69:3",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_4",
    "text": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
    "book": "الحاقة",
    "number": "69:4",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_5",
    "text": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
    "book": "الحاقة",
    "number": "69:5",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_6",
    "text": "وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ",
    "book": "الحاقة",
    "number": "69:6",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_7",
    "text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَـٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ",
    "book": "الحاقة",
    "number": "69:7",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_8",
    "text": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ",
    "book": "الحاقة",
    "number": "69:8",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_9",
    "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَـٰتُ بِٱلْخَاطِئَةِ",
    "book": "الحاقة",
    "number": "69:9",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_10",
    "text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً",
    "book": "الحاقة",
    "number": "69:10",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_11",
    "text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَـٰكُمْ فِى ٱلْجَارِيَةِ",
    "book": "الحاقة",
    "number": "69:11",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_12",
    "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ",
    "book": "الحاقة",
    "number": "69:12",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_13",
    "text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ",
    "book": "الحاقة",
    "number": "69:13",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_14",
    "text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً",
    "book": "الحاقة",
    "number": "69:14",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_15",
    "text": "فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ",
    "book": "الحاقة",
    "number": "69:15",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_16",
    "text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ",
    "book": "الحاقة",
    "number": "69:16",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_17",
    "text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَـٰنِيَةٌ",
    "book": "الحاقة",
    "number": "69:17",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_18",
    "text": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ",
    "book": "الحاقة",
    "number": "69:18",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_19",
    "text": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَـٰبِيَهْ",
    "book": "الحاقة",
    "number": "69:19",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_20",
    "text": "إِنِّى ظَنَنتُ أَنِّى مُلَـٰقٍ حِسَابِيَهْ",
    "book": "الحاقة",
    "number": "69:20",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_21",
    "text": "فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ",
    "book": "الحاقة",
    "number": "69:21",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_22",
    "text": "فِى جَنَّةٍ عَالِيَةٍ",
    "book": "الحاقة",
    "number": "69:22",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_23",
    "text": "قُطُوفُهَا دَانِيَةٌ",
    "book": "الحاقة",
    "number": "69:23",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_24",
    "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
    "book": "الحاقة",
    "number": "69:24",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_25",
    "text": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَـٰلَيْتَنِى لَمْ أُوتَ كِتَـٰبِيَهْ",
    "book": "الحاقة",
    "number": "69:25",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_26",
    "text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
    "book": "الحاقة",
    "number": "69:26",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_27",
    "text": "يَـٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
    "book": "الحاقة",
    "number": "69:27",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_28",
    "text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
    "book": "الحاقة",
    "number": "69:28",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_29",
    "text": "هَلَكَ عَنِّى سُلْطَـٰنِيَهْ",
    "book": "الحاقة",
    "number": "69:29",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_30",
    "text": "خُذُوهُ فَغُلُّوهُ",
    "book": "الحاقة",
    "number": "69:30",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_31",
    "text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
    "book": "الحاقة",
    "number": "69:31",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_32",
    "text": "ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ",
    "book": "الحاقة",
    "number": "69:32",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_33",
    "text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
    "book": "الحاقة",
    "number": "69:33",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_34",
    "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
    "book": "الحاقة",
    "number": "69:34",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_35",
    "text": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَـٰهُنَا حَمِيمٌ",
    "book": "الحاقة",
    "number": "69:35",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_36",
    "text": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ",
    "book": "الحاقة",
    "number": "69:36",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_37",
    "text": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَـٰطِـُٔونَ",
    "book": "الحاقة",
    "number": "69:37",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_38",
    "text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
    "book": "الحاقة",
    "number": "69:38",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_39",
    "text": "وَمَا لَا تُبْصِرُونَ",
    "book": "الحاقة",
    "number": "69:39",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_40",
    "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ",
    "book": "الحاقة",
    "number": "69:40",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_41",
    "text": "وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَّا تُؤْمِنُونَ",
    "book": "الحاقة",
    "number": "69:41",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_42",
    "text": "وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَّا تَذَكَّرُونَ",
    "book": "الحاقة",
    "number": "69:42",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_43",
    "text": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
    "book": "الحاقة",
    "number": "69:43",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_44",
    "text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
    "book": "الحاقة",
    "number": "69:44",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_45",
    "text": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
    "book": "الحاقة",
    "number": "69:45",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_46",
    "text": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
    "book": "الحاقة",
    "number": "69:46",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_47",
    "text": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَـٰجِزِينَ",
    "book": "الحاقة",
    "number": "69:47",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_48",
    "text": "وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ",
    "book": "الحاقة",
    "number": "69:48",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_49",
    "text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
    "book": "الحاقة",
    "number": "69:49",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_50",
    "text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَـٰفِرِينَ",
    "book": "الحاقة",
    "number": "69:50",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_51",
    "text": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
    "book": "الحاقة",
    "number": "69:51",
    "chapter": "الحاقة"
  },
  {
    "id": "quran_69_52",
    "text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
    "book": "الحاقة",
    "number": "69:52",
    "chapter": "الحاقة"
  }
]