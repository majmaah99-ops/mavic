[
  {
    "id": "quran_96_1",
    "text": " ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
    "book": "العلق",
    "number": "96:1",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_2",
    "text": "خَلَقَ ٱلْإِنسَـٰنَ مِنْ عَلَقٍ",
    "book": "العلق",
    "number": "96:2",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_3",
    "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
    "book": "العلق",
    "number": "96:3",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_4",
    "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
    "book": "العلق",
    "number": "96:4",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_5",
    "text": "عَلَّمَ ٱلْإِنسَـٰنَ مَا لَمْ يَعْلَمْ",
    "book": "العلق",
    "number": "96:5",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_6",
    "text": "كَلَّآ إِنَّ ٱلْإِنسَـٰنَ لَيَطْغَىٰٓ",
    "book": "العلق",
    "number": "96:6",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_7",
    "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
    "book": "العلق",
    "number": "96:7",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_8",
    "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
    "book": "العلق",
    "number": "96:8",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_9",
    "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
    "book": "العلق",
    "number": "96:9",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_10",
    "text": "عَبْدًا إِذَا صَلَّىٰٓ",
    "book": "العلق",
    "number": "96:10",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_11",
    "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
    "book": "العلق",
    "number": "96:11",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_12",
    "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
    "book": "العلق",
    "number": "96:12",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_13",
    "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
    "book": "العلق",
    "number": "96:13",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_14",
    "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
    "book": "العلق",
    "number": "96:14",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_15",
    "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
    "book": "العلق",
    "number": "96:15",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_16",
    "text": "نَاصِيَةٍ كَـٰذِبَةٍ خَاطِئَةٍ",
    "book": "العلق",
    "number": "96:16",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_17",
    "text": "فَلْيَدْعُ نَادِيَهُۥ",
    "book": "العلق",
    "number": "96:17",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_18",
    "text": "سَنَدْعُ ٱلزَّبَانِيَةَ",
    "book": "العلق",
    "number": "96:18",
    "chapter": "العلق"
  },
  {
    "id": "quran_96_19",
    "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
    "book": "العلق",
    "number": "96:19",
    "chapter": "العلق"
  }
