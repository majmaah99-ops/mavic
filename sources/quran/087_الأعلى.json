[
  {
    "id": "quran_87_1",
    "text": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
    "book": "الأعلى",
    "number": "87:1",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_2",
    "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
    "book": "الأعلى",
    "number": "87:2",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_3",
    "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
    "book": "الأعلى",
    "number": "87:3",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_4",
    "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
    "book": "الأعلى",
    "number": "87:4",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_5",
    "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
    "book": "الأعلى",
    "number": "87:5",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_6",
    "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
    "book": "الأعلى",
    "number": "87:6",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_7",
    "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
    "book": "الأعلى",
    "number": "87:7",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_8",
    "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
    "book": "الأعلى",
    "number": "87:8",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_9",
    "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
    "book": "الأعلى",
    "number": "87:9",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_10",
    "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
    "book": "الأعلى",
    "number": "87:10",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_11",
    "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
    "book": "الأعلى",
    "number": "87:11",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_12",
    "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
    "book": "الأعلى",
    "number": "87:12",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_13",
    "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
    "book": "الأعلى",
    "number": "87:13",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_14",
    "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
    "book": "الأعلى",
    "number": "87:14",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_15",
    "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
    "book": "الأعلى",
    "number": "87:15",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_16",
    "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
    "book": "الأعلى",
    "number": "87:16",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_17",
    "text": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
    "book": "الأعلى",
    "number": "87:17",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_18",
    "text": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
    "book": "الأعلى",
    "number": "87:18",
    "chapter": "الأعلى"
  },
  {
    "id": "quran_87_19",
    "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
    "book": "الأعلى",
    "number": "87:19",
    "chapter": "الأعلى"
  }
]