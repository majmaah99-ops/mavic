    "text": "إِذْ نَجَّيْنَـٰهُ وَأَهْلَهُۥٓ أَجْمَعِينَ",
    "book": "الصافات",
    "number": "37:134",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_135",
    "text": "إِلَّا عَجُوزًا فِى ٱلْغَـٰبِرِينَ",
    "book": "الصافات",
    "number": "37:135",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_136",
    "text": "ثُمَّ دَمَّرْنَا ٱلْـَٔاخَرِينَ",
    "book": "الصافات",
    "number": "37:136",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_137",
    "text": "وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِم مُّصْبِحِينَ",
    "book": "الصافات",
    "number": "37:137",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_138",
    "text": "وَبِٱلَّيْلِ ۗ أَفَلَا تَعْقِلُونَ",
    "book": "الصافات",
    "number": "37:138",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_139",
    "text": "وَإِنَّ يُونُسَ لَمِنَ ٱلْمُرْسَلِينَ",
    "book": "الصافات",
    "number": "37:139",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_140",
    "text": "إِذْ أَبَقَ إِلَى ٱلْفُلْكِ ٱلْمَشْحُونِ",
    "book": "الصافات",
    "number": "37:140",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_141",
    "text": "فَسَاهَمَ فَكَانَ مِنَ ٱلْمُدْحَضِينَ",
    "book": "الصافات",
    "number": "37:141",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_142",
    "text": "فَٱلْتَقَمَهُ ٱلْحُوتُ وَهُوَ مُلِيمٌ",
    "book": "الصافات",
    "number": "37:142",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_143",
    "text": "فَلَوْلَآ أَنَّهُۥ كَانَ مِنَ ٱلْمُسَبِّحِينَ",
    "book": "الصافات",
    "number": "37:143",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_144",
    "text": "لَلَبِثَ فِى بَطْنِهِۦٓ إِلَىٰ يَوْمِ يُبْعَثُونَ",
    "book": "الصافات",
    "number": "37:144",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_145",
    "text": "۞ فَنَبَذْنَـٰهُ بِٱلْعَرَآءِ وَهُوَ سَقِيمٌ",
    "book": "الصافات",
    "number": "37:145",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_146",
    "text": "وَأَنۢبَتْنَا عَلَيْهِ شَجَرَةً مِّن يَقْطِينٍ",
    "book": "الصافات",
    "number": "37:146",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_147",
    "text": "وَأَرْسَلْنَـٰهُ إِلَىٰ مِا۟ئَةِ أَلْفٍ أَوْ يَزِيدُونَ",
    "book": "الصافات",
    "number": "37:147",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_148",
    "text": "فَـَٔامَنُوا۟ فَمَتَّعْنَـٰهُمْ إِلَىٰ حِينٍ",
    "book": "الصافات",
    "number": "37:148",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_149",
    "text": "فَٱسْتَفْتِهِمْ أَلِرَبِّكَ ٱلْبَنَاتُ وَلَهُمُ ٱلْبَنُونَ",
    "book": "الصافات",
    "number": "37:149",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_150",
    "text": "أَمْ خَلَقْنَا ٱلْمَلَـٰٓئِكَةَ إِنَـٰثًا وَهُمْ شَـٰهِدُونَ",
    "book": "الصافات",
    "number": "37:150",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_151",
    "text": "أَلَآ إِنَّهُم مِّنْ إِفْكِهِمْ لَيَقُولُونَ",
    "book": "الصافات",
    "number": "37:151",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_152",
    "text": "وَلَدَ ٱللَّهُ وَإِنَّهُمْ لَكَـٰذِبُونَ",
    "book": "الصافات",
    "number": "37:152",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_153",
    "text": "أَصْطَفَى ٱلْبَنَاتِ عَلَى ٱلْبَنِينَ",
    "book": "الصافات",
    "number": "37:153",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_154",
    "text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
    "book": "الصافات",
    "number": "37:154",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_155",
    "text": "أَفَلَا تَذَكَّرُونَ",
    "book": "الصافات",
    "number": "37:155",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_156",
    "text": "أَمْ لَكُمْ سُلْطَـٰنٌ مُّبِينٌ",
    "book": "الصافات",
    "number": "37:156",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_157",
    "text": "فَأْتُوا۟ بِكِتَـٰبِكُمْ إِن كُنتُمْ صَـٰدِقِينَ",
    "book": "الصافات",
    "number": "37:157",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_158",
    "text": "وَجَعَلُوا۟ بَيْنَهُۥ وَبَيْنَ ٱلْجِنَّةِ نَسَبًا ۚ وَلَقَدْ عَلِمَتِ ٱلْجِنَّةُ إِنَّهُمْ لَمُحْضَرُونَ",
    "book": "الصافات",
    "number": "37:158",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_159",
    "text": "سُبْحَـٰنَ ٱللَّهِ عَمَّا يَصِفُونَ",
    "book": "الصافات",
    "number": "37:159",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_160",
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
    "book": "الصافات",
    "number": "37:160",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_161",
    "text": "فَإِنَّكُمْ وَمَا تَعْبُدُونَ",
    "book": "الصافات",
    "number": "37:161",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_162",
    "text": "مَآ أَنتُمْ عَلَيْهِ بِفَـٰتِنِينَ",
    "book": "الصافات",
    "number": "37:162",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_163",
    "text": "إِلَّا مَنْ هُوَ صَالِ ٱلْجَحِيمِ",
    "book": "الصافات",
    "number": "37:163",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_164",
    "text": "وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامٌ مَّعْلُومٌ",
    "book": "الصافات",
    "number": "37:164",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_165",
    "text": "وَإِنَّا لَنَحْنُ ٱلصَّآفُّونَ",
    "book": "الصافات",
    "number": "37:165",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_166",
    "text": "وَإِنَّا لَنَحْنُ ٱلْمُسَبِّحُونَ",
    "book": "الصافات",
    "number": "37:166",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_167",
    "text": "وَإِن كَانُوا۟ لَيَقُولُونَ",
    "book": "الصافات",
    "number": "37:167",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_168",
    "text": "لَوْ أَنَّ عِندَنَا ذِكْرًا مِّنَ ٱلْأَوَّلِينَ",
    "book": "الصافات",
    "number": "37:168",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_169",
    "text": "لَكُنَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
    "book": "الصافات",
    "number": "37:169",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_170",
    "text": "فَكَفَرُوا۟ بِهِۦ ۖ فَسَوْفَ يَعْلَمُونَ",
    "book": "الصافات",
    "number": "37:170",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_171",
    "text": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا ٱلْمُرْسَلِينَ",
    "book": "الصافات",
    "number": "37:171",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_172",
    "text": "إِنَّهُمْ لَهُمُ ٱلْمَنصُورُونَ",
    "book": "الصافات",
    "number": "37:172",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_173",
    "text": "وَإِنَّ جُندَنَا لَهُمُ ٱلْغَـٰلِبُونَ",
    "book": "الصافات",
    "number": "37:173",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_174",
    "text": "فَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
    "book": "الصافات",
    "number": "37:174",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_175",
    "text": "وَأَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ",
    "book": "الصافات",
    "number": "37:175",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_176",
    "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
    "book": "الصافات",
    "number": "37:176",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_177",
    "text": "فَإِذَا نَزَلَ بِسَاحَتِهِمْ فَسَآءَ صَبَاحُ ٱلْمُنذَرِينَ",
    "book": "الصافات",
    "number": "37:177",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_178",
    "text": "وَتَوَلَّ عَنْهُمْ حَتَّىٰ حِينٍ",
    "book": "الصافات",
    "number": "37:178",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_179",
    "text": "وَأَبْصِرْ فَسَوْفَ يُبْصِرُونَ",
    "book": "الصافات",
    "number": "37:179",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_180",
    "text": "سُبْحَـٰنَ رَبِّكَ رَبِّ ٱلْعِزَّةِ عَمَّا يَصِفُونَ",
    "book": "الصافات",
    "number": "37:180",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_181",
    "text": "وَسَلَـٰمٌ عَلَى ٱلْمُرْسَلِينَ",
    "book": "الصافات",
    "number": "37:181",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_182",
    "text": "وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ",
    "book": "الصافات",
    "number": "37:182",
    "chapter": "الصافات"
  }
