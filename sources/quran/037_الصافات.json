[
  {
    "id": "quran_37_1",
    "text": " وَٱلصَّـٰٓفَّـٰتِ صَفًّا",
    "book": "الصافات",
    "number": "37:1",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_2",
    "text": "فَٱلزَّٰجِرَٰتِ زَجْرًا",
    "book": "الصافات",
    "number": "37:2",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_3",
    "text": "فَٱلتَّـٰلِيَـٰتِ ذِكْرًا",
    "book": "الصافات",
    "number": "37:3",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_4",
    "text": "إِنَّ إِلَـٰهَكُمْ لَوَٰحِدٌ",
    "book": "الصافات",
    "number": "37:4",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_5",
    "text": "رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَـٰرِقِ",
    "book": "الصافات",
    "number": "37:5",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_6",
    "text": "إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",
    "book": "الصافات",
    "number": "37:6",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_7",
    "text": "وَحِفْظًا مِّن كُلِّ شَيْطَـٰنٍ مَّارِدٍ",
    "book": "الصافات",
    "number": "37:7",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_8",
    "text": "لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍ",
    "book": "الصافات",
    "number": "37:8",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_9",
    "text": "دُحُورًا ۖ وَلَهُمْ عَذَابٌ وَاصِبٌ",
    "book": "الصافات",
    "number": "37:9",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_10",
    "text": "إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌ ثَاقِبٌ",
    "book": "الصافات",
    "number": "37:10",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_11",
    "text": "فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَـٰهُم مِّن طِينٍ لَّازِبٍۭ",
    "book": "الصافات",
    "number": "37:11",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_12",
    "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَ",
    "book": "الصافات",
    "number": "37:12",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_13",
    "text": "وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ",
    "book": "الصافات",
    "number": "37:13",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_14",
    "text": "وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ",
    "book": "الصافات",
    "number": "37:14",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_15",
    "text": "وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ",
    "book": "الصافات",
    "number": "37:15",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_16",
    "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
    "book": "الصافات",
    "number": "37:16",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_17",
    "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
    "book": "الصافات",
    "number": "37:17",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_18",
    "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ",
    "book": "الصافات",
    "number": "37:18",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_19",
    "text": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ",
    "book": "الصافات",
    "number": "37:19",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_20",
    "text": "وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ",
    "book": "الصافات",
    "number": "37:20",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_21",
    "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
    "book": "الصافات",
    "number": "37:21",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_22",
    "text": "۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ",
    "book": "الصافات",
    "number": "37:22",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_23",
    "text": "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",
    "book": "الصافات",
    "number": "37:23",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_24",
    "text": "وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ",
    "book": "الصافات",
    "number": "37:24",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_25",
    "text": "مَا لَكُمْ لَا تَنَاصَرُونَ",
    "book": "الصافات",
    "number": "37:25",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_26",
    "text": "بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ",
    "book": "الصافات",
    "number": "37:26",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_27",
    "text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
    "book": "الصافات",
    "number": "37:27",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_28",
    "text": "قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ",
    "book": "الصافات",
    "number": "37:28",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_29",
    "text": "قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ",
    "book": "الصافات",
    "number": "37:29",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_30",
    "text": "وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ",
    "book": "الصافات",
    "number": "37:30",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_31",
    "text": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ",
    "book": "الصافات",
    "number": "37:31",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_32",
    "text": "فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ",
    "book": "الصافات",
    "number": "37:32",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_33",
    "text": "فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ",
    "book": "الصافات",
    "number": "37:33",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_34",
    "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
    "book": "الصافات",
    "number": "37:34",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_35",
    "text": "إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ",
    "book": "الصافات",
    "number": "37:35",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_36",
    "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ",
    "book": "الصافات",
    "number": "37:36",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_37",
    "text": "بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",
    "book": "الصافات",
    "number": "37:37",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_38",
    "text": "إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ",
    "book": "الصافات",
    "number": "37:38",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_39",
    "text": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",
    "book": "الصافات",
    "number": "37:39",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_40",
    "text": "إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",
    "book": "الصافات",
    "number": "37:40",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_41",
    "text": "أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ",
    "book": "الصافات",
    "number": "37:41",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_42",
    "text": "فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ",
    "book": "الصافات",
    "number": "37:42",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_43",
    "text": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
    "book": "الصافات",
    "number": "37:43",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_44",
    "text": "عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ",
    "book": "الصافات",
    "number": "37:44",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_45",
    "text": "يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ",
    "book": "الصافات",
    "number": "37:45",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_46",
    "text": "بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ",
    "book": "الصافات",
    "number": "37:46",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_47",
    "text": "لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ",
    "book": "الصافات",
    "number": "37:47",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_48",
    "text": "وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ",
    "book": "الصافات",
    "number": "37:48",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_49",
    "text": "كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ",
    "book": "الصافات",
    "number": "37:49",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_50",
    "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ",
    "book": "الصافات",
    "number": "37:50",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_51",
    "text": "قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ",
    "book": "الصافات",
    "number": "37:51",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_52",
    "text": "يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ",
    "book": "الصافات",
    "number": "37:52",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_53",
    "text": "أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ",
    "book": "الصافات",
    "number": "37:53",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_54",
    "text": "قَالَ هَلْ أَنتُم مُّطَّلِعُونَ",
    "book": "الصافات",
    "number": "37:54",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_55",
    "text": "فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ",
    "book": "الصافات",
    "number": "37:55",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_56",
    "text": "قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ",
    "book": "الصافات",
    "number": "37:56",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_57",
    "text": "وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ",
    "book": "الصافات",
    "number": "37:57",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_58",
    "text": "أَفَمَا نَحْنُ بِمَيِّتِينَ",
    "book": "الصافات",
    "number": "37:58",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_59",
    "text": "إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ",
    "book": "الصافات",
    "number": "37:59",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_60",
    "text": "إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ",
    "book": "الصافات",
    "number": "37:60",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_61",
    "text": "لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ",
    "book": "الصافات",
    "number": "37:61",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_62",
    "text": "أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ",
    "book": "الصافات",
    "number": "37:62",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_63",
    "text": "إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ",
    "book": "الصافات",
    "number": "37:63",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_64",
    "text": "إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ",
    "book": "الصافات",
    "number": "37:64",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_65",
    "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ",
    "book": "الصافات",
    "number": "37:65",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_66",
    "text": "فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
    "book": "الصافات",
    "number": "37:66",
    "chapter": "الصافات"
  },
  {
    "id": "quran_37_67",
    "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ",
    "book": "الصافات",
