[
  {
    "id": "quran_82_1",
    "text": " إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
    "book": "الإنفطار",
    "number": "82:1",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_2",
    "text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
    "book": "الإنفطار",
    "number": "82:2",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_3",
    "text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
    "book": "الإنفطار",
    "number": "82:3",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_4",
    "text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
    "book": "الإنفطار",
    "number": "82:4",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_5",
    "text": "عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَأَخَّرَتْ",
    "book": "الإنفطار",
    "number": "82:5",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_6",
    "text": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
    "book": "الإنفطار",
    "number": "82:6",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_7",
    "text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
    "book": "الإنفطار",
    "number": "82:7",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_8",
    "text": "فِىٓ أَىِّ صُورَةٍ مَّا شَآءَ رَكَّبَكَ",
    "book": "الإنفطار",
    "number": "82:8",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_9",
    "text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
    "book": "الإنفطار",
    "number": "82:9",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_10",
    "text": "وَإِنَّ عَلَيْكُمْ لَحَـٰفِظِينَ",
    "book": "الإنفطار",
    "number": "82:10",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_11",
    "text": "كِرَامًا كَـٰتِبِينَ",
    "book": "الإنفطار",
    "number": "82:11",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_12",
    "text": "يَعْلَمُونَ مَا تَفْعَلُونَ",
    "book": "الإنفطار",
    "number": "82:12",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_13",
    "text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
    "book": "الإنفطار",
    "number": "82:13",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_14",
    "text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍ",
    "book": "الإنفطار",
    "number": "82:14",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_15",
    "text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
    "book": "الإنفطار",
    "number": "82:15",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_16",
    "text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
    "book": "الإنفطار",
    "number": "82:16",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_17",
    "text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
    "book": "الإنفطار",
    "number": "82:17",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_18",
    "text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
    "book": "الإنفطار",
    "number": "82:18",
    "chapter": "الإنفطار"
  },
  {
    "id": "quran_82_19",
    "text": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍ لِّلَّهِ",
    "book": "الإنفطار",
    "number": "82:19",
    "chapter": "الإنفطار"
  }
]