[
  {
    "id": "quran_93_1",
    "text": " وَٱلضُّحَىٰ",
    "book": "الضحى",
    "number": "93:1",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_2",
    "text": "وَٱلَّيْلِ إِذَا سَجَىٰ",
    "book": "الضحى",
    "number": "93:2",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_3",
    "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
    "book": "الضحى",
    "number": "93:3",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_4",
    "text": "وَلَلْـَٔاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ",
    "book": "الضحى",
    "number": "93:4",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_5",
    "text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
    "book": "الضحى",
    "number": "93:5",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_6",
    "text": "أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ",
    "book": "الضحى",
    "number": "93:6",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_7",
    "text": "وَوَجَدَكَ ضَآلًّا فَهَدَىٰ",
    "book": "الضحى",
    "number": "93:7",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_8",
    "text": "وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ",
    "book": "الضحى",
    "number": "93:8",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_9",
    "text": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
    "book": "الضحى",
    "number": "93:9",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_10",
    "text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
    "book": "الضحى",
    "number": "93:10",
    "chapter": "الضحى"
  },
  {
    "id": "quran_93_11",
    "text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
    "book": "الضحى",
    "number": "93:11",
    "chapter": "الضحى"
  }
]