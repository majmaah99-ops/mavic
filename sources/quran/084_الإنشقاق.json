[
  {
    "id": "quran_84_1",
    "text": " إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
    "book": "الإنشقاق",
    "number": "84:1",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_2",
    "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
    "book": "الإنشقاق",
    "number": "84:2",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_3",
    "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
    "book": "الإنشقاق",
    "number": "84:3",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_4",
    "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
    "book": "الإنشقاق",
    "number": "84:4",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_5",
    "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
    "book": "الإنشقاق",
    "number": "84:5",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_6",
    "text": "يَـٰٓأَيُّهَا ٱلْإِنسَـٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَـٰقِيهِ",
    "book": "الإنشقاق",
    "number": "84:6",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_7",
    "text": "فَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ بِيَمِينِهِۦ",
    "book": "الإنشقاق",
    "number": "84:7",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_8",
    "text": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا",
    "book": "الإنشقاق",
    "number": "84:8",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_9",
    "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا",
    "book": "الإنشقاق",
    "number": "84:9",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_10",
    "text": "وَأَمَّا مَنْ أُوتِىَ كِتَـٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
    "book": "الإنشقاق",
    "number": "84:10",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_11",
    "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا",
    "book": "الإنشقاق",
    "number": "84:11",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_12",
    "text": "وَيَصْلَىٰ سَعِيرًا",
    "book": "الإنشقاق",
    "number": "84:12",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_13",
    "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
    "book": "الإنشقاق",
    "number": "84:13",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_14",
    "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
    "book": "الإنشقاق",
    "number": "84:14",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_15",
    "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا",
    "book": "الإنشقاق",
    "number": "84:15",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_16",
    "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
    "book": "الإنشقاق",
    "number": "84:16",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_17",
    "text": "وَٱلَّيْلِ وَمَا وَسَقَ",
    "book": "الإنشقاق",
    "number": "84:17",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_18",
    "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
    "book": "الإنشقاق",
    "number": "84:18",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_19",
    "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ",
    "book": "الإنشقاق",
    "number": "84:19",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_20",
    "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
    "book": "الإنشقاق",
    "number": "84:20",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_21",
    "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
    "book": "الإنشقاق",
    "number": "84:21",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_22",
    "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
    "book": "الإنشقاق",
    "number": "84:22",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_23",
    "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
    "book": "الإنشقاق",
    "number": "84:23",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_24",
    "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
    "book": "الإنشقاق",
    "number": "84:24",
    "chapter": "الإنشقاق"
  },
  {
    "id": "quran_84_25",
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
    "book": "الإنشقاق",
    "number": "84:25",
    "chapter": "الإنشقاق"
  }
]