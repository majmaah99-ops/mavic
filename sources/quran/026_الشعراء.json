  },
  {
    "id": "quran_26_189",
    "text": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ",
    "book": "الشعراء",
    "number": "26:189",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_190",
    "text": "إِنَّ فِى ذَٰلِكَ لَـَٔايَةً ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ",
    "book": "الشعراء",
    "number": "26:190",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_191",
    "text": "وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
    "book": "الشعراء",
    "number": "26:191",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_192",
    "text": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَـٰلَمِينَ",
    "book": "الشعراء",
    "number": "26:192",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_193",
    "text": "نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ",
    "book": "الشعراء",
    "number": "26:193",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_194",
    "text": "عَلَىٰ قَلْبِكَ لِتَكُونَ مِنَ ٱلْمُنذِرِينَ",
    "book": "الشعراء",
    "number": "26:194",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_195",
    "text": "بِلِسَانٍ عَرَبِىٍّ مُّبِينٍ",
    "book": "الشعراء",
    "number": "26:195",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_196",
    "text": "وَإِنَّهُۥ لَفِى زُبُرِ ٱلْأَوَّلِينَ",
    "book": "الشعراء",
    "number": "26:196",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_197",
    "text": "أَوَلَمْ يَكُن لَّهُمْ ءَايَةً أَن يَعْلَمَهُۥ عُلَمَـٰٓؤُا۟ بَنِىٓ إِسْرَٰٓءِيلَ",
    "book": "الشعراء",
    "number": "26:197",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_198",
    "text": "وَلَوْ نَزَّلْنَـٰهُ عَلَىٰ بَعْضِ ٱلْأَعْجَمِينَ",
    "book": "الشعراء",
    "number": "26:198",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_199",
    "text": "فَقَرَأَهُۥ عَلَيْهِم مَّا كَانُوا۟ بِهِۦ مُؤْمِنِينَ",
    "book": "الشعراء",
    "number": "26:199",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_200",
    "text": "كَذَٰلِكَ سَلَكْنَـٰهُ فِى قُلُوبِ ٱلْمُجْرِمِينَ",
    "book": "الشعراء",
    "number": "26:200",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_201",
    "text": "لَا يُؤْمِنُونَ بِهِۦ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ",
    "book": "الشعراء",
    "number": "26:201",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_202",
    "text": "فَيَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ",
    "book": "الشعراء",
    "number": "26:202",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_203",
    "text": "فَيَقُولُوا۟ هَلْ نَحْنُ مُنظَرُونَ",
    "book": "الشعراء",
    "number": "26:203",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_204",
    "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَ",
    "book": "الشعراء",
    "number": "26:204",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_205",
    "text": "أَفَرَءَيْتَ إِن مَّتَّعْنَـٰهُمْ سِنِينَ",
    "book": "الشعراء",
    "number": "26:205",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_206",
    "text": "ثُمَّ جَآءَهُم مَّا كَانُوا۟ يُوعَدُونَ",
    "book": "الشعراء",
    "number": "26:206",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_207",
    "text": "مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يُمَتَّعُونَ",
    "book": "الشعراء",
    "number": "26:207",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_208",
    "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ إِلَّا لَهَا مُنذِرُونَ",
    "book": "الشعراء",
    "number": "26:208",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_209",
    "text": "ذِكْرَىٰ وَمَا كُنَّا ظَـٰلِمِينَ",
    "book": "الشعراء",
    "number": "26:209",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_210",
    "text": "وَمَا تَنَزَّلَتْ بِهِ ٱلشَّيَـٰطِينُ",
    "book": "الشعراء",
    "number": "26:210",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_211",
    "text": "وَمَا يَنۢبَغِى لَهُمْ وَمَا يَسْتَطِيعُونَ",
    "book": "الشعراء",
    "number": "26:211",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_212",
    "text": "إِنَّهُمْ عَنِ ٱلسَّمْعِ لَمَعْزُولُونَ",
    "book": "الشعراء",
    "number": "26:212",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_213",
    "text": "فَلَا تَدْعُ مَعَ ٱللَّهِ إِلَـٰهًا ءَاخَرَ فَتَكُونَ مِنَ ٱلْمُعَذَّبِينَ",
    "book": "الشعراء",
    "number": "26:213",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_214",
    "text": "وَأَنذِرْ عَشِيرَتَكَ ٱلْأَقْرَبِينَ",
    "book": "الشعراء",
    "number": "26:214",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_215",
    "text": "وَٱخْفِضْ جَنَاحَكَ لِمَنِ ٱتَّبَعَكَ مِنَ ٱلْمُؤْمِنِينَ",
    "book": "الشعراء",
    "number": "26:215",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_216",
    "text": "فَإِنْ عَصَوْكَ فَقُلْ إِنِّى بَرِىٓءٌ مِّمَّا تَعْمَلُونَ",
    "book": "الشعراء",
    "number": "26:216",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_217",
    "text": "وَتَوَكَّلْ عَلَى ٱلْعَزِيزِ ٱلرَّحِيمِ",
    "book": "الشعراء",
    "number": "26:217",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_218",
    "text": "ٱلَّذِى يَرَىٰكَ حِينَ تَقُومُ",
    "book": "الشعراء",
    "number": "26:218",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_219",
    "text": "وَتَقَلُّبَكَ فِى ٱلسَّـٰجِدِينَ",
    "book": "الشعراء",
    "number": "26:219",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_220",
    "text": "إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
    "book": "الشعراء",
    "number": "26:220",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_221",
    "text": "هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ ٱلشَّيَـٰطِينُ",
    "book": "الشعراء",
    "number": "26:221",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_222",
    "text": "تَنَزَّلُ عَلَىٰ كُلِّ أَفَّاكٍ أَثِيمٍ",
    "book": "الشعراء",
    "number": "26:222",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_223",
    "text": "يُلْقُونَ ٱلسَّمْعَ وَأَكْثَرُهُمْ كَـٰذِبُونَ",
    "book": "الشعراء",
    "number": "26:223",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_224",
    "text": "وَٱلشُّعَرَآءُ يَتَّبِعُهُمُ ٱلْغَاوُۥنَ",
    "book": "الشعراء",
    "number": "26:224",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_225",
    "text": "أَلَمْ تَرَ أَنَّهُمْ فِى كُلِّ وَادٍ يَهِيمُونَ",
    "book": "الشعراء",
    "number": "26:225",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_226",
    "text": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَ",
    "book": "الشعراء",
    "number": "26:226",
    "chapter": "الشعراء"
  },
  {
    "id": "quran_26_227",
    "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَذَكَرُوا۟ ٱللَّهَ كَثِيرًا وَٱنتَصَرُوا۟ مِنۢ بَعْدِ مَا ظُلِمُوا۟ ۗ وَسَيَعْلَمُ ٱلَّذِينَ ظَلَمُوٓا۟ أَىَّ مُنقَلَبٍ يَنقَلِبُونَ",
    "book": "الشعراء",
    "number": "26:227",
    "chapter": "الشعراء"
  }
]