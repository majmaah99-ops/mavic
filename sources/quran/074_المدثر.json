[
  {
    "id": "quran_74_1",
    "text": " يَـٰٓأَيُّهَا ٱلْمُدَّثِّرُ",
    "book": "المدثر",
    "number": "74:1",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_2",
    "text": "قُمْ فَأَنذِرْ",
    "book": "المدثر",
    "number": "74:2",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_3",
    "text": "وَرَبَّكَ فَكَبِّرْ",
    "book": "المدثر",
    "number": "74:3",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_4",
    "text": "وَثِيَابَكَ فَطَهِّرْ",
    "book": "المدثر",
    "number": "74:4",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_5",
    "text": "وَٱلرُّجْزَ فَٱهْجُرْ",
    "book": "المدثر",
    "number": "74:5",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_6",
    "text": "وَلَا تَمْنُن تَسْتَكْثِرُ",
    "book": "المدثر",
    "number": "74:6",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_7",
    "text": "وَلِرَبِّكَ فَٱصْبِرْ",
    "book": "المدثر",
    "number": "74:7",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_8",
    "text": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ",
    "book": "المدثر",
    "number": "74:8",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_9",
    "text": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ",
    "book": "المدثر",
    "number": "74:9",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_10",
    "text": "عَلَى ٱلْكَـٰفِرِينَ غَيْرُ يَسِيرٍ",
    "book": "المدثر",
    "number": "74:10",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_11",
    "text": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا",
    "book": "المدثر",
    "number": "74:11",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_12",
    "text": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا",
    "book": "المدثر",
    "number": "74:12",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_13",
    "text": "وَبَنِينَ شُهُودًا",
    "book": "المدثر",
    "number": "74:13",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_14",
    "text": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا",
    "book": "المدثر",
    "number": "74:14",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_15",
    "text": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ",
    "book": "المدثر",
    "number": "74:15",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_16",
    "text": "كَلَّآ ۖ إِنَّهُۥ كَانَ لِـَٔايَـٰتِنَا عَنِيدًا",
    "book": "المدثر",
    "number": "74:16",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_17",
    "text": "سَأُرْهِقُهُۥ صَعُودًا",
    "book": "المدثر",
    "number": "74:17",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_18",
    "text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ",
    "book": "المدثر",
    "number": "74:18",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_19",
    "text": "فَقُتِلَ كَيْفَ قَدَّرَ",
    "book": "المدثر",
    "number": "74:19",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_20",
    "text": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ",
    "book": "المدثر",
    "number": "74:20",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_21",
    "text": "ثُمَّ نَظَرَ",
    "book": "المدثر",
    "number": "74:21",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_22",
    "text": "ثُمَّ عَبَسَ وَبَسَرَ",
    "book": "المدثر",
    "number": "74:22",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_23",
    "text": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ",
    "book": "المدثر",
    "number": "74:23",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_24",
    "text": "فَقَالَ إِنْ هَـٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ",
    "book": "المدثر",
    "number": "74:24",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_25",
    "text": "إِنْ هَـٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ",
    "book": "المدثر",
    "number": "74:25",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_26",
    "text": "سَأُصْلِيهِ سَقَرَ",
    "book": "المدثر",
    "number": "74:26",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_27",
    "text": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ",
    "book": "المدثر",
    "number": "74:27",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_28",
    "text": "لَا تُبْقِى وَلَا تَذَرُ",
    "book": "المدثر",
    "number": "74:28",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_29",
    "text": "لَوَّاحَةٌ لِّلْبَشَرِ",
    "book": "المدثر",
    "number": "74:29",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_30",
    "text": "عَلَيْهَا تِسْعَةَ عَشَرَ",
    "book": "المدثر",
    "number": "74:30",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_31",
    "text": "وَمَا جَعَلْنَآ أَصْحَـٰبَ ٱلنَّارِ إِلَّا مَلَـٰٓئِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَـٰنًا ۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَـٰبَ وَٱلْمُؤْمِنُونَ ۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَـٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَـٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ",
    "book": "المدثر",
    "number": "74:31",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_32",
    "text": "كَلَّا وَٱلْقَمَرِ",
    "book": "المدثر",
    "number": "74:32",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_33",
    "text": "وَٱلَّيْلِ إِذْ أَدْبَرَ",
    "book": "المدثر",
    "number": "74:33",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_34",
    "text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ",
    "book": "المدثر",
    "number": "74:34",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_35",
    "text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ",
    "book": "المدثر",
    "number": "74:35",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_36",
    "text": "نَذِيرًا لِّلْبَشَرِ",
    "book": "المدثر",
    "number": "74:36",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_37",
    "text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ",
    "book": "المدثر",
    "number": "74:37",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_38",
    "text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ",
    "book": "المدثر",
    "number": "74:38",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_39",
    "text": "إِلَّآ أَصْحَـٰبَ ٱلْيَمِينِ",
    "book": "المدثر",
    "number": "74:39",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_40",
    "text": "فِى جَنَّـٰتٍ يَتَسَآءَلُونَ",
    "book": "المدثر",
    "number": "74:40",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_41",
    "text": "عَنِ ٱلْمُجْرِمِينَ",
    "book": "المدثر",
    "number": "74:41",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_42",
    "text": "مَا سَلَكَكُمْ فِى سَقَرَ",
    "book": "المدثر",
    "number": "74:42",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_43",
    "text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ",
    "book": "المدثر",
    "number": "74:43",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_44",
    "text": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ",
    "book": "المدثر",
    "number": "74:44",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_45",
    "text": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ",
    "book": "المدثر",
    "number": "74:45",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_46",
    "text": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ",
    "book": "المدثر",
    "number": "74:46",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_47",
    "text": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ",
    "book": "المدثر",
    "number": "74:47",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_48",
    "text": "فَمَا تَنفَعُهُمْ شَفَـٰعَةُ ٱلشَّـٰفِعِينَ",
    "book": "المدثر",
    "number": "74:48",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_49",
    "text": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ",
    "book": "المدثر",
    "number": "74:49",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_50",
    "text": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ",
    "book": "المدثر",
    "number": "74:50",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_51",
    "text": "فَرَّتْ مِن قَسْوَرَةٍۭ",
    "book": "المدثر",
    "number": "74:51",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_52",
    "text": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً",
    "book": "المدثر",
    "number": "74:52",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_53",
    "text": "كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْـَٔاخِرَةَ",
    "book": "المدثر",
    "number": "74:53",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_54",
    "text": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌ",
    "book": "المدثر",
    "number": "74:54",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_55",
    "text": "فَمَن شَآءَ ذَكَرَهُۥ",
    "book": "المدثر",
    "number": "74:55",
    "chapter": "المدثر"
  },
  {
    "id": "quran_74_56",
    "text": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ",
    "book": "المدثر",
    "number": "74:56",
    "chapter": "المدثر"
  }
]