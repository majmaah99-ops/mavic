[
  {
    "id": "quran_56_1",
    "text": " إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
    "book": "الواقعة",
    "number": "56:1",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_2",
    "text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
    "book": "الواقعة",
    "number": "56:2",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_3",
    "text": "خَافِضَةٌ رَّافِعَةٌ",
    "book": "الواقعة",
    "number": "56:3",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_4",
    "text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
    "book": "الواقعة",
    "number": "56:4",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_5",
    "text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
    "book": "الواقعة",
    "number": "56:5",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_6",
    "text": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
    "book": "الواقعة",
    "number": "56:6",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_7",
    "text": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
    "book": "الواقعة",
    "number": "56:7",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_8",
    "text": "فَأَصْحَـٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
    "book": "الواقعة",
    "number": "56:8",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_9",
    "text": "وَأَصْحَـٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
    "book": "الواقعة",
    "number": "56:9",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_10",
    "text": "وَٱلسَّـٰبِقُونَ ٱلسَّـٰبِقُونَ",
    "book": "الواقعة",
    "number": "56:10",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_11",
    "text": "أُو۟لَـٰٓئِكَ ٱلْمُقَرَّبُونَ",
    "book": "الواقعة",
    "number": "56:11",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_12",
    "text": "فِى جَنَّـٰتِ ٱلنَّعِيمِ",
    "book": "الواقعة",
    "number": "56:12",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_13",
    "text": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
    "book": "الواقعة",
    "number": "56:13",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_14",
    "text": "وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ",
    "book": "الواقعة",
    "number": "56:14",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_15",
    "text": "عَلَىٰ سُرُرٍ مَّوْضُونَةٍ",
    "book": "الواقعة",
    "number": "56:15",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_16",
    "text": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ",
    "book": "الواقعة",
    "number": "56:16",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_17",
    "text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
    "book": "الواقعة",
    "number": "56:17",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_18",
    "text": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
    "book": "الواقعة",
    "number": "56:18",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_19",
    "text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
    "book": "الواقعة",
    "number": "56:19",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_20",
    "text": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
    "book": "الواقعة",
    "number": "56:20",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_21",
    "text": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
    "book": "الواقعة",
    "number": "56:21",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_22",
    "text": "وَحُورٌ عِينٌ",
    "book": "الواقعة",
    "number": "56:22",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_23",
    "text": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
    "book": "الواقعة",
    "number": "56:23",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_24",
    "text": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
    "book": "الواقعة",
    "number": "56:24",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_25",
    "text": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
    "book": "الواقعة",
    "number": "56:25",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_26",
    "text": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
    "book": "الواقعة",
    "number": "56:26",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_27",
    "text": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
    "book": "الواقعة",
    "number": "56:27",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_28",
    "text": "فِى سِدْرٍ مَّخْضُودٍ",
    "book": "الواقعة",
    "number": "56:28",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_29",
    "text": "وَطَلْحٍ مَّنضُودٍ",
    "book": "الواقعة",
    "number": "56:29",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_30",
    "text": "وَظِلٍّ مَّمْدُودٍ",
    "book": "الواقعة",
    "number": "56:30",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_31",
    "text": "وَمَآءٍ مَّسْكُوبٍ",
    "book": "الواقعة",
    "number": "56:31",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_32",
    "text": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
    "book": "الواقعة",
    "number": "56:32",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_33",
    "text": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
    "book": "الواقعة",
    "number": "56:33",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_34",
    "text": "وَفُرُشٍ مَّرْفُوعَةٍ",
    "book": "الواقعة",
    "number": "56:34",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_35",
    "text": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
    "book": "الواقعة",
    "number": "56:35",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_36",
    "text": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
    "book": "الواقعة",
    "number": "56:36",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_37",
    "text": "عُرُبًا أَتْرَابًا",
    "book": "الواقعة",
    "number": "56:37",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_38",
    "text": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
    "book": "الواقعة",
    "number": "56:38",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_39",
    "text": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
    "book": "الواقعة",
    "number": "56:39",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_40",
    "text": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
    "book": "الواقعة",
    "number": "56:40",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_41",
    "text": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
    "book": "الواقعة",
    "number": "56:41",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_42",
    "text": "فِى سَمُومٍ وَحَمِيمٍ",
    "book": "الواقعة",
    "number": "56:42",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_43",
    "text": "وَظِلٍّ مِّن يَحْمُومٍ",
    "book": "الواقعة",
    "number": "56:43",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_44",
    "text": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
    "book": "الواقعة",
    "number": "56:44",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_45",
    "text": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
    "book": "الواقعة",
    "number": "56:45",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_46",
    "text": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
    "book": "الواقعة",
    "number": "56:46",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_47",
    "text": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
    "book": "الواقعة",
    "number": "56:47",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_48",
    "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
    "book": "الواقعة",
    "number": "56:48",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_49",
    "text": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
    "book": "الواقعة",
    "number": "56:49",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_50",
    "text": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
    "book": "الواقعة",
    "number": "56:50",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_51",
    "text": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
    "book": "الواقعة",
    "number": "56:51",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_52",
    "text": "لَـَٔاكِلُونَ مِن شَجَرٍ مِّن زَقُّومٍ",
    "book": "الواقعة",
    "number": "56:52",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_53",
    "text": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
    "book": "الواقعة",
    "number": "56:53",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_54",
    "text": "فَشَـٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
    "book": "الواقعة",
    "number": "56:54",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_55",
    "text": "فَشَـٰرِبُونَ شُرْبَ ٱلْهِيمِ",
    "book": "الواقعة",
    "number": "56:55",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_56",
    "text": "هَـٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
    "book": "الواقعة",
    "number": "56:56",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_57",
    "text": "نَحْنُ خَلَقْنَـٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
    "book": "الواقعة",
    "number": "56:57",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_58",
    "text": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
    "book": "الواقعة",
    "number": "56:58",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_59",
    "text": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَـٰلِقُونَ",
    "book": "الواقعة",
    "number": "56:59",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_60",
    "text": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
    "book": "الواقعة",
    "number": "56:60",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_61",
    "text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَـٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
    "book": "الواقعة",
    "number": "56:61",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_62",
    "text": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
    "book": "الواقعة",
    "number": "56:62",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_63",
    "text": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
    "book": "الواقعة",
    "number": "56:63",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_64",
    "text": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
    "book": "الواقعة",
    "number": "56:64",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_65",
    "text": "لَوْ نَشَآءُ لَجَعَلْنَـٰهُ حُطَـٰمًا فَظَلْتُمْ تَفَكَّهُونَ",
    "book": "الواقعة",
    "number": "56:65",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_66",
    "text": "إِنَّا لَمُغْرَمُونَ",
    "book": "الواقعة",
    "number": "56:66",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_67",
    "text": "بَلْ نَحْنُ مَحْرُومُونَ",
    "book": "الواقعة",
    "number": "56:67",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_68",
    "text": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
    "book": "الواقعة",
    "number": "56:68",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_69",
    "text": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
    "book": "الواقعة",
    "number": "56:69",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_70",
    "text": "لَوْ نَشَآءُ جَعَلْنَـٰهُ أُجَاجًا فَلَوْلَا تَشْكُرُونَ",
    "book": "الواقعة",
    "number": "56:70",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_71",
    "text": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
    "book": "الواقعة",
    "number": "56:71",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_72",
    "text": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
    "book": "الواقعة",
    "number": "56:72",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_73",
    "text": "نَحْنُ جَعَلْنَـٰهَا تَذْكِرَةً وَمَتَـٰعًا لِّلْمُقْوِينَ",
    "book": "الواقعة",
    "number": "56:73",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_74",
    "text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
    "book": "الواقعة",
    "number": "56:74",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_75",
    "text": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
    "book": "الواقعة",
    "number": "56:75",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_76",
    "text": "وَإِنَّهُۥ لَقَسَمٌ لَّوْ تَعْلَمُونَ عَظِيمٌ",
    "book": "الواقعة",
    "number": "56:76",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_77",
    "text": "إِنَّهُۥ لَقُرْءَانٌ كَرِيمٌ",
    "book": "الواقعة",
    "number": "56:77",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_78",
    "text": "فِى كِتَـٰبٍ مَّكْنُونٍ",
    "book": "الواقعة",
    "number": "56:78",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_79",
    "text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
    "book": "الواقعة",
    "number": "56:79",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_80",
    "text": "تَنزِيلٌ مِّن رَّبِّ ٱلْعَـٰلَمِينَ",
    "book": "الواقعة",
    "number": "56:80",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_81",
    "text": "أَفَبِهَـٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
    "book": "الواقعة",
    "number": "56:81",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_82",
    "text": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
    "book": "الواقعة",
    "number": "56:82",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_83",
    "text": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
    "book": "الواقعة",
    "number": "56:83",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_84",
    "text": "وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ",
    "book": "الواقعة",
    "number": "56:84",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_85",
    "text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَـٰكِن لَّا تُبْصِرُونَ",
    "book": "الواقعة",
    "number": "56:85",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_86",
    "text": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
    "book": "الواقعة",
    "number": "56:86",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_87",
    "text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَـٰدِقِينَ",
    "book": "الواقعة",
    "number": "56:87",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_88",
    "text": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
    "book": "الواقعة",
    "number": "56:88",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_89",
    "text": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ",
    "book": "الواقعة",
    "number": "56:89",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_90",
    "text": "وَأَمَّآ إِن كَانَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
    "book": "الواقعة",
    "number": "56:90",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_91",
    "text": "فَسَلَـٰمٌ لَّكَ مِنْ أَصْحَـٰبِ ٱلْيَمِينِ",
    "book": "الواقعة",
    "number": "56:91",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_92",
    "text": "وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ",
    "book": "الواقعة",
    "number": "56:92",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_93",
    "text": "فَنُزُلٌ مِّنْ حَمِيمٍ",
    "book": "الواقعة",
    "number": "56:93",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_94",
    "text": "وَتَصْلِيَةُ جَحِيمٍ",
    "book": "الواقعة",
    "number": "56:94",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_95",
    "text": "إِنَّ هَـٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ",
    "book": "الواقعة",
    "number": "56:95",
    "chapter": "الواقعة"
  },
  {
    "id": "quran_56_96",
    "text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
    "book": "الواقعة",
    "number": "56:96",
    "chapter": "الواقعة"
  }
