[
  {
    "id": "quran_75_1",
    "text": " لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَـٰمَةِ",
    "book": "القيامة",
    "number": "75:1",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_2",
    "text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
    "book": "القيامة",
    "number": "75:2",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_3",
    "text": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
    "book": "القيامة",
    "number": "75:3",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_4",
    "text": "بَلَىٰ قَـٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
    "book": "القيامة",
    "number": "75:4",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_5",
    "text": "بَلْ يُرِيدُ ٱلْإِنسَـٰنُ لِيَفْجُرَ أَمَامَهُۥ",
    "book": "القيامة",
    "number": "75:5",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_6",
    "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَـٰمَةِ",
    "book": "القيامة",
    "number": "75:6",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_7",
    "text": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
    "book": "القيامة",
    "number": "75:7",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_8",
    "text": "وَخَسَفَ ٱلْقَمَرُ",
    "book": "القيامة",
    "number": "75:8",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_9",
    "text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
    "book": "القيامة",
    "number": "75:9",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_10",
    "text": "يَقُولُ ٱلْإِنسَـٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
    "book": "القيامة",
    "number": "75:10",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_11",
    "text": "كَلَّا لَا وَزَرَ",
    "book": "القيامة",
    "number": "75:11",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_12",
    "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
    "book": "القيامة",
    "number": "75:12",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_13",
    "text": "يُنَبَّؤُا۟ ٱلْإِنسَـٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
    "book": "القيامة",
    "number": "75:13",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_14",
    "text": "بَلِ ٱلْإِنسَـٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌ",
    "book": "القيامة",
    "number": "75:14",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_15",
    "text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
    "book": "القيامة",
    "number": "75:15",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_16",
    "text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
    "book": "القيامة",
    "number": "75:16",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_17",
    "text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
    "book": "القيامة",
    "number": "75:17",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_18",
    "text": "فَإِذَا قَرَأْنَـٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
    "book": "القيامة",
    "number": "75:18",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_19",
    "text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
    "book": "القيامة",
    "number": "75:19",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_20",
    "text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
    "book": "القيامة",
    "number": "75:20",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_21",
    "text": "وَتَذَرُونَ ٱلْـَٔاخِرَةَ",
    "book": "القيامة",
    "number": "75:21",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_22",
    "text": "وُجُوهٌ يَوْمَئِذٍ نَّاضِرَةٌ",
    "book": "القيامة",
    "number": "75:22",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_23",
    "text": "إِلَىٰ رَبِّهَا نَاظِرَةٌ",
    "book": "القيامة",
    "number": "75:23",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_24",
    "text": "وَوُجُوهٌ يَوْمَئِذٍۭ بَاسِرَةٌ",
    "book": "القيامة",
    "number": "75:24",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_25",
    "text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌ",
    "book": "القيامة",
    "number": "75:25",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_26",
    "text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
    "book": "القيامة",
    "number": "75:26",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_27",
    "text": "وَقِيلَ مَنْ ۜ رَاقٍ",
    "book": "القيامة",
    "number": "75:27",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_28",
    "text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
    "book": "القيامة",
    "number": "75:28",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_29",
    "text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
    "book": "القيامة",
    "number": "75:29",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_30",
    "text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
    "book": "القيامة",
    "number": "75:30",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_31",
    "text": "فَلَا صَدَّقَ وَلَا صَلَّىٰ",
    "book": "القيامة",
    "number": "75:31",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_32",
    "text": "وَلَـٰكِن كَذَّبَ وَتَوَلَّىٰ",
    "book": "القيامة",
    "number": "75:32",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_33",
    "text": "ثُمَّ ذَهَبَ إِلَىٰٓ أَهْلِهِۦ يَتَمَطَّىٰٓ",
    "book": "القيامة",
    "number": "75:33",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_34",
    "text": "أَوْلَىٰ لَكَ فَأَوْلَىٰ",
    "book": "القيامة",
    "number": "75:34",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_35",
    "text": "ثُمَّ أَوْلَىٰ لَكَ فَأَوْلَىٰٓ",
    "book": "القيامة",
    "number": "75:35",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_36",
    "text": "أَيَحْسَبُ ٱلْإِنسَـٰنُ أَن يُتْرَكَ سُدًى",
    "book": "القيامة",
    "number": "75:36",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_37",
    "text": "أَلَمْ يَكُ نُطْفَةً مِّن مَّنِىٍّ يُمْنَىٰ",
    "book": "القيامة",
    "number": "75:37",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_38",
    "text": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ",
    "book": "القيامة",
    "number": "75:38",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_39",
    "text": "فَجَعَلَ مِنْهُ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
    "book": "القيامة",
    "number": "75:39",
    "chapter": "القيامة"
  },
  {
    "id": "quran_75_40",
    "text": "أَلَيْسَ ذَٰلِكَ بِقَـٰدِرٍ عَلَىٰٓ أَن يُحْـِۧىَ ٱلْمَوْتَىٰ",
    "book": "القيامة",
    "number": "75:40",
    "chapter": "القيامة"
  }
]