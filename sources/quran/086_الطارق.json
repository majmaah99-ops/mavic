[
  {
    "id": "quran_86_1",
    "text": " وَٱلسَّمَآءِ وَٱلطَّارِقِ",
    "book": "الطارق",
    "number": "86:1",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_2",
    "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
    "book": "الطارق",
    "number": "86:2",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_3",
    "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
    "book": "الطارق",
    "number": "86:3",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_4",
    "text": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
    "book": "الطارق",
    "number": "86:4",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_5",
    "text": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
    "book": "الطارق",
    "number": "86:5",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_6",
    "text": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
    "book": "الطارق",
    "number": "86:6",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_7",
    "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
    "book": "الطارق",
    "number": "86:7",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_8",
    "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
    "book": "الطارق",
    "number": "86:8",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_9",
    "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
    "book": "الطارق",
    "number": "86:9",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_10",
    "text": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
    "book": "الطارق",
    "number": "86:10",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_11",
    "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
    "book": "الطارق",
    "number": "86:11",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_12",
    "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
    "book": "الطارق",
    "number": "86:12",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_13",
    "text": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
    "book": "الطارق",
    "number": "86:13",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_14",
    "text": "وَمَا هُوَ بِٱلْهَزْلِ",
    "book": "الطارق",
    "number": "86:14",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_15",
    "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
    "book": "الطارق",
    "number": "86:15",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_16",
    "text": "وَأَكِيدُ كَيْدًا",
    "book": "الطارق",
    "number": "86:16",
    "chapter": "الطارق"
  },
  {
    "id": "quran_86_17",
    "text": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
    "book": "الطارق",
    "number": "86:17",
    "chapter": "الطارق"
  }
