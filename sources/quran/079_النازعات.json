[
  {
    "id": "quran_79_1",
    "text": " وَٱلنَّـٰزِعَـٰتِ غَرْقًا",
    "book": "النازعات",
    "number": "79:1",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_2",
    "text": "وَٱلنَّـٰشِطَـٰتِ نَشْطًا",
    "book": "النازعات",
    "number": "79:2",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_3",
    "text": "وَٱلسَّـٰبِحَـٰتِ سَبْحًا",
    "book": "النازعات",
    "number": "79:3",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_4",
    "text": "فَٱلسَّـٰبِقَـٰتِ سَبْقًا",
    "book": "النازعات",
    "number": "79:4",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_5",
    "text": "فَٱلْمُدَبِّرَٰتِ أَمْرًا",
    "book": "النازعات",
    "number": "79:5",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_6",
    "text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
    "book": "النازعات",
    "number": "79:6",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_7",
    "text": "تَتْبَعُهَا ٱلرَّادِفَةُ",
    "book": "النازعات",
    "number": "79:7",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_8",
    "text": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ",
    "book": "النازعات",
    "number": "79:8",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_9",
    "text": "أَبْصَـٰرُهَا خَـٰشِعَةٌ",
    "book": "النازعات",
    "number": "79:9",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_10",
    "text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
    "book": "النازعات",
    "number": "79:10",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_11",
    "text": "أَءِذَا كُنَّا عِظَـٰمًا نَّخِرَةً",
    "book": "النازعات",
    "number": "79:11",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_12",
    "text": "قَالُوا۟ تِلْكَ إِذًا كَرَّةٌ خَاسِرَةٌ",
    "book": "النازعات",
    "number": "79:12",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_13",
    "text": "فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ",
    "book": "النازعات",
    "number": "79:13",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_14",
    "text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
    "book": "النازعات",
    "number": "79:14",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_15",
    "text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
    "book": "النازعات",
    "number": "79:15",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_16",
    "text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
    "book": "النازعات",
    "number": "79:16",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_17",
    "text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
    "book": "النازعات",
    "number": "79:17",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_18",
    "text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
    "book": "النازعات",
    "number": "79:18",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_19",
    "text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
    "book": "النازعات",
    "number": "79:19",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_20",
    "text": "فَأَرَىٰهُ ٱلْـَٔايَةَ ٱلْكُبْرَىٰ",
    "book": "النازعات",
    "number": "79:20",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_21",
    "text": "فَكَذَّبَ وَعَصَىٰ",
    "book": "النازعات",
    "number": "79:21",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_22",
    "text": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
    "book": "النازعات",
    "number": "79:22",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_23",
    "text": "فَحَشَرَ فَنَادَىٰ",
    "book": "النازعات",
    "number": "79:23",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_24",
    "text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
    "book": "النازعات",
    "number": "79:24",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_25",
    "text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْـَٔاخِرَةِ وَٱلْأُولَىٰٓ",
    "book": "النازعات",
    "number": "79:25",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_26",
    "text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّمَن يَخْشَىٰٓ",
    "book": "النازعات",
    "number": "79:26",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_27",
    "text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
    "book": "النازعات",
    "number": "79:27",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_28",
    "text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
    "book": "النازعات",
    "number": "79:28",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_29",
    "text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
    "book": "النازعات",
    "number": "79:29",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_30",
    "text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
    "book": "النازعات",
    "number": "79:30",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_31",
    "text": "أَخْرَجَ مِنْهَا مَآءَهَا وَمَرْعَىٰهَا",
    "book": "النازعات",
    "number": "79:31",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_32",
    "text": "وَٱلْجِبَالَ أَرْسَىٰهَا",
    "book": "النازعات",
    "number": "79:32",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_33",
    "text": "مَتَـٰعًا لَّكُمْ وَلِأَنْعَـٰمِكُمْ",
    "book": "النازعات",
    "number": "79:33",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_34",
    "text": "فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلْكُبْرَىٰ",
    "book": "النازعات",
    "number": "79:34",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_35",
    "text": "يَوْمَ يَتَذَكَّرُ ٱلْإِنسَـٰنُ مَا سَعَىٰ",
    "book": "النازعات",
    "number": "79:35",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_36",
    "text": "وَبُرِّزَتِ ٱلْجَحِيمُ لِمَن يَرَىٰ",
    "book": "النازعات",
    "number": "79:36",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_37",
    "text": "فَأَمَّا مَن طَغَىٰ",
    "book": "النازعات",
    "number": "79:37",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_38",
    "text": "وَءَاثَرَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
    "book": "النازعات",
    "number": "79:38",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_39",
    "text": "فَإِنَّ ٱلْجَحِيمَ هِىَ ٱلْمَأْوَىٰ",
    "book": "النازعات",
    "number": "79:39",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_40",
    "text": "وَأَمَّا مَنْ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفْسَ عَنِ ٱلْهَوَىٰ",
    "book": "النازعات",
    "number": "79:40",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_41",
    "text": "فَإِنَّ ٱلْجَنَّةَ هِىَ ٱلْمَأْوَىٰ",
    "book": "النازعات",
    "number": "79:41",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_42",
    "text": "يَسْـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرْسَىٰهَا",
    "book": "النازعات",
    "number": "79:42",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_43",
    "text": "فِيمَ أَنتَ مِن ذِكْرَىٰهَآ",
    "book": "النازعات",
    "number": "79:43",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_44",
    "text": "إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ",
    "book": "النازعات",
    "number": "79:44",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_45",
    "text": "إِنَّمَآ أَنتَ مُنذِرُ مَن يَخْشَىٰهَا",
    "book": "النازعات",
    "number": "79:45",
    "chapter": "النازعات"
  },
  {
    "id": "quran_79_46",
    "text": "كَأَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوٓا۟ إِلَّا عَشِيَّةً أَوْ ضُحَىٰهَا",
    "book": "النازعات",
    "number": "79:46",
    "chapter": "النازعات"
  }
]