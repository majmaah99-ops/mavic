[
  {
    "id": "quran_70_1",
    "text": " سَأَلَ سَآئِلٌۢ بِعَذَابٍ وَاقِعٍ",
    "book": "المعارج",
    "number": "70:1",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_2",
    "text": "لِّلْكَـٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌ",
    "book": "المعارج",
    "number": "70:2",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_3",
    "text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
    "book": "المعارج",
    "number": "70:3",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_4",
    "text": "تَعْرُجُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍ",
    "book": "المعارج",
    "number": "70:4",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_5",
    "text": "فَٱصْبِرْ صَبْرًا جَمِيلًا",
    "book": "المعارج",
    "number": "70:5",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_6",
    "text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًا",
    "book": "المعارج",
    "number": "70:6",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_7",
    "text": "وَنَرَىٰهُ قَرِيبًا",
    "book": "المعارج",
    "number": "70:7",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_8",
    "text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
    "book": "المعارج",
    "number": "70:8",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_9",
    "text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
    "book": "المعارج",
    "number": "70:9",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_10",
    "text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًا",
    "book": "المعارج",
    "number": "70:10",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_11",
    "text": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
    "book": "المعارج",
    "number": "70:11",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_12",
    "text": "وَصَـٰحِبَتِهِۦ وَأَخِيهِ",
    "book": "المعارج",
    "number": "70:12",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_13",
    "text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
    "book": "المعارج",
    "number": "70:13",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_14",
    "text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ يُنجِيهِ",
    "book": "المعارج",
    "number": "70:14",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_15",
    "text": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
    "book": "المعارج",
    "number": "70:15",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_16",
    "text": "نَزَّاعَةً لِّلشَّوَىٰ",
    "book": "المعارج",
    "number": "70:16",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_17",
    "text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
    "book": "المعارج",
    "number": "70:17",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_18",
    "text": "وَجَمَعَ فَأَوْعَىٰٓ",
    "book": "المعارج",
    "number": "70:18",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_19",
    "text": "۞ إِنَّ ٱلْإِنسَـٰنَ خُلِقَ هَلُوعًا",
    "book": "المعارج",
    "number": "70:19",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_20",
    "text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًا",
    "book": "المعارج",
    "number": "70:20",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_21",
    "text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
    "book": "المعارج",
    "number": "70:21",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_22",
    "text": "إِلَّا ٱلْمُصَلِّينَ",
    "book": "المعارج",
    "number": "70:22",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_23",
    "text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
    "book": "المعارج",
    "number": "70:23",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_24",
    "text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ",
    "book": "المعارج",
    "number": "70:24",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_25",
    "text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
    "book": "المعارج",
    "number": "70:25",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_26",
    "text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
    "book": "المعارج",
    "number": "70:26",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_27",
    "text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
    "book": "المعارج",
    "number": "70:27",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_28",
    "text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍ",
    "book": "المعارج",
    "number": "70:28",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_29",
    "text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَـٰفِظُونَ",
    "book": "المعارج",
    "number": "70:29",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_30",
    "text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَـٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
    "book": "المعارج",
    "number": "70:30",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_31",
    "text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَـٰٓئِكَ هُمُ ٱلْعَادُونَ",
    "book": "المعارج",
    "number": "70:31",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_32",
    "text": "وَٱلَّذِينَ هُمْ لِأَمَـٰنَـٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
    "book": "المعارج",
    "number": "70:32",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_33",
    "text": "وَٱلَّذِينَ هُم بِشَهَـٰدَٰتِهِمْ قَآئِمُونَ",
    "book": "المعارج",
    "number": "70:33",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_34",
    "text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
    "book": "المعارج",
    "number": "70:34",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_35",
    "text": "أُو۟لَـٰٓئِكَ فِى جَنَّـٰتٍ مُّكْرَمُونَ",
    "book": "المعارج",
    "number": "70:35",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_36",
    "text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
    "book": "المعارج",
    "number": "70:36",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_37",
    "text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
    "book": "المعارج",
    "number": "70:37",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_38",
    "text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍ",
    "book": "المعارج",
    "number": "70:38",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_39",
    "text": "كَلَّآ ۖ إِنَّا خَلَقْنَـٰهُم مِّمَّا يَعْلَمُونَ",
    "book": "المعارج",
    "number": "70:39",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_40",
    "text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَـٰرِقِ وَٱلْمَغَـٰرِبِ إِنَّا لَقَـٰدِرُونَ",
    "book": "المعارج",
    "number": "70:40",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_41",
    "text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
    "book": "المعارج",
    "number": "70:41",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_42",
    "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَـٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
    "book": "المعارج",
    "number": "70:42",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_43",
    "text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًا كَأَنَّهُمْ إِلَىٰ نُصُبٍ يُوفِضُونَ",
    "book": "المعارج",
    "number": "70:43",
    "chapter": "المعارج"
  },
  {
    "id": "quran_70_44",
    "text": "خَـٰشِعَةً أَبْصَـٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
    "book": "المعارج",
    "number": "70:44",
    "chapter": "المعارج"
  }
]