[
  {
    "id": "quran_88_1",
    "text": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
    "book": "الغاشية",
    "number": "88:1",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_2",
    "text": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
    "book": "الغاشية",
    "number": "88:2",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_3",
    "text": "عَامِلَةٌ نَّاصِبَةٌ",
    "book": "الغاشية",
    "number": "88:3",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_4",
    "text": "تَصْلَىٰ نَارًا حَامِيَةً",
    "book": "الغاشية",
    "number": "88:4",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_5",
    "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
    "book": "الغاشية",
    "number": "88:5",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_6",
    "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
    "book": "الغاشية",
    "number": "88:6",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_7",
    "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
    "book": "الغاشية",
    "number": "88:7",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_8",
    "text": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
    "book": "الغاشية",
    "number": "88:8",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_9",
    "text": "لِّسَعْيِهَا رَاضِيَةٌ",
    "book": "الغاشية",
    "number": "88:9",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_10",
    "text": "فِى جَنَّةٍ عَالِيَةٍ",
    "book": "الغاشية",
    "number": "88:10",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_11",
    "text": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
    "book": "الغاشية",
    "number": "88:11",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_12",
    "text": "فِيهَا عَيْنٌ جَارِيَةٌ",
    "book": "الغاشية",
    "number": "88:12",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_13",
    "text": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
    "book": "الغاشية",
    "number": "88:13",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_14",
    "text": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
    "book": "الغاشية",
    "number": "88:14",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_15",
    "text": "وَنَمَارِقُ مَصْفُوفَةٌ",
    "book": "الغاشية",
    "number": "88:15",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_16",
    "text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
    "book": "الغاشية",
    "number": "88:16",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_17",
    "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
    "book": "الغاشية",
    "number": "88:17",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_18",
    "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
    "book": "الغاشية",
    "number": "88:18",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_19",
    "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
    "book": "الغاشية",
    "number": "88:19",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_20",
    "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
    "book": "الغاشية",
    "number": "88:20",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_21",
    "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
    "book": "الغاشية",
    "number": "88:21",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_22",
    "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
    "book": "الغاشية",
    "number": "88:22",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_23",
    "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
    "book": "الغاشية",
    "number": "88:23",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_24",
    "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
    "book": "الغاشية",
    "number": "88:24",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_25",
    "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
    "book": "الغاشية",
    "number": "88:25",
    "chapter": "الغاشية"
  },
  {
    "id": "quran_88_26",
    "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
    "book": "الغاشية",
    "number": "88:26",
    "chapter": "الغاشية"
  }
]