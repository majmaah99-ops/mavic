[
  {
    "id": "quran_78_1",
    "text": " عَمَّ يَتَسَآءَلُونَ",
    "book": "النبإ",
    "number": "78:1",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_2",
    "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
    "book": "النبإ",
    "number": "78:2",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_3",
    "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
    "book": "النبإ",
    "number": "78:3",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_4",
    "text": "كَلَّا سَيَعْلَمُونَ",
    "book": "النبإ",
    "number": "78:4",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_5",
    "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
    "book": "النبإ",
    "number": "78:5",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_6",
    "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
    "book": "النبإ",
    "number": "78:6",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_7",
    "text": "وَٱلْجِبَالَ أَوْتَادًا",
    "book": "النبإ",
    "number": "78:7",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_8",
    "text": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
    "book": "النبإ",
    "number": "78:8",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_9",
    "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
    "book": "النبإ",
    "number": "78:9",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_10",
    "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
    "book": "النبإ",
    "number": "78:10",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_11",
    "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
    "book": "النبإ",
    "number": "78:11",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_12",
    "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
    "book": "النبإ",
    "number": "78:12",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_13",
    "text": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
    "book": "النبإ",
    "number": "78:13",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_14",
    "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
    "book": "النبإ",
    "number": "78:14",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_15",
    "text": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
    "book": "النبإ",
    "number": "78:15",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_16",
    "text": "وَجَنَّـٰتٍ أَلْفَافًا",
    "book": "النبإ",
    "number": "78:16",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_17",
    "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
    "book": "النبإ",
    "number": "78:17",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_18",
    "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
    "book": "النبإ",
    "number": "78:18",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_19",
    "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
    "book": "النبإ",
    "number": "78:19",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_20",
    "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
    "book": "النبإ",
    "number": "78:20",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_21",
    "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
    "book": "النبإ",
    "number": "78:21",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_22",
    "text": "لِّلطَّـٰغِينَ مَـَٔابًا",
    "book": "النبإ",
    "number": "78:22",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_23",
    "text": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
    "book": "النبإ",
    "number": "78:23",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_24",
    "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
    "book": "النبإ",
    "number": "78:24",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_25",
    "text": "إِلَّا حَمِيمًا وَغَسَّاقًا",
    "book": "النبإ",
    "number": "78:25",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_26",
    "text": "جَزَآءً وِفَاقًا",
    "book": "النبإ",
    "number": "78:26",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_27",
    "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
    "book": "النبإ",
    "number": "78:27",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_28",
    "text": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا",
    "book": "النبإ",
    "number": "78:28",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_29",
    "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
    "book": "النبإ",
    "number": "78:29",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_30",
    "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
    "book": "النبإ",
    "number": "78:30",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_31",
    "text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
    "book": "النبإ",
    "number": "78:31",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_32",
    "text": "حَدَآئِقَ وَأَعْنَـٰبًا",
    "book": "النبإ",
    "number": "78:32",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_33",
    "text": "وَكَوَاعِبَ أَتْرَابًا",
    "book": "النبإ",
    "number": "78:33",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_34",
    "text": "وَكَأْسًا دِهَاقًا",
    "book": "النبإ",
    "number": "78:34",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_35",
    "text": "لَّا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا كِذَّٰبًا",
    "book": "النبإ",
    "number": "78:35",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_36",
    "text": "جَزَآءً مِّن رَّبِّكَ عَطَآءً حِسَابًا",
    "book": "النبإ",
    "number": "78:36",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_37",
    "text": "رَّبِّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلرَّحْمَـٰنِ ۖ لَا يَمْلِكُونَ مِنْهُ خِطَابًا",
    "book": "النبإ",
    "number": "78:37",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_38",
    "text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَـٰٓئِكَةُ صَفًّا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَـٰنُ وَقَالَ صَوَابًا",
    "book": "النبإ",
    "number": "78:38",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_39",
    "text": "ذَٰلِكَ ٱلْيَوْمُ ٱلْحَقُّ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا",
    "book": "النبإ",
    "number": "78:39",
    "chapter": "النبإ"
  },
  {
    "id": "quran_78_40",
    "text": "إِنَّآ أَنذَرْنَـٰكُمْ عَذَابًا قَرِيبًا يَوْمَ يَنظُرُ ٱلْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ ٱلْكَافِرُ يَـٰلَيْتَنِى كُنتُ تُرَٰبًۢا",
    "book": "النبإ",
    "number": "78:40",
    "chapter": "النبإ"
  }
]