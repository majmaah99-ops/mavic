[
  {
    "id": "quran_85_1",
    "text": " وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
    "book": "البروج",
    "number": "85:1",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_2",
    "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
    "book": "البروج",
    "number": "85:2",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_3",
    "text": "وَشَاهِدٍ وَمَشْهُودٍ",
    "book": "البروج",
    "number": "85:3",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_4",
    "text": "قُتِلَ أَصْحَـٰبُ ٱلْأُخْدُودِ",
    "book": "البروج",
    "number": "85:4",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_5",
    "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
    "book": "البروج",
    "number": "85:5",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_6",
    "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌ",
    "book": "البروج",
    "number": "85:6",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_7",
    "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ",
    "book": "البروج",
    "number": "85:7",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_8",
    "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
    "book": "البروج",
    "number": "85:8",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_9",
    "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ",
    "book": "البروج",
    "number": "85:9",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_10",
    "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
    "book": "البروج",
    "number": "85:10",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_11",
    "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَهُمْ جَنَّـٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَـٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
    "book": "البروج",
    "number": "85:11",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_12",
    "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
    "book": "البروج",
    "number": "85:12",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_13",
    "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
    "book": "البروج",
    "number": "85:13",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_14",
    "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
    "book": "البروج",
    "number": "85:14",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_15",
    "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
    "book": "البروج",
    "number": "85:15",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_16",
    "text": "فَعَّالٌ لِّمَا يُرِيدُ",
    "book": "البروج",
    "number": "85:16",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_17",
    "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
    "book": "البروج",
    "number": "85:17",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_18",
    "text": "فِرْعَوْنَ وَثَمُودَ",
    "book": "البروج",
    "number": "85:18",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_19",
    "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ",
    "book": "البروج",
    "number": "85:19",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_20",
    "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
    "book": "البروج",
    "number": "85:20",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_21",
    "text": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ",
    "book": "البروج",
    "number": "85:21",
    "chapter": "البروج"
  },
  {
    "id": "quran_85_22",
    "text": "فِى لَوْحٍ مَّحْفُوظٍۭ",
    "book": "البروج",
    "number": "85:22",
    "chapter": "البروج"
  }
]